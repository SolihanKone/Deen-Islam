# Local secrets for debug runs only. Never listed as a Flutter asset.
#
#   cp .env.example .env
#   flutter run --dart-define-from-file=.env
#
# Cursor / VS Code launch.json already passes --dart-define-from-file=.env
#
# Store/release builds must omit INSTALL_LOG_URL.

# Debug-only anonymous install counting. Leave empty for store builds.
INSTALL_LOG_URL=
INSTALL_LOG_KEY=dc_install_local
